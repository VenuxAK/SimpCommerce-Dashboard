VITE_API_URL=http://localhost:8000/api

# For per-store deployments, set the store slug to lock this dashboard to one store.
# Root users will be blocked from logging in. Leave empty for multi-store / root dashboard.
# VITE_STORE_SLUG=clothing
# VITE_APP_MODE=system|store

# Dev server proxy target configuration
VITE_PROXY_TARGET=http://localhost:8000

# Nightwatch dashboard URL
VITE_NIGHTWATCH_URL=https://nightwatch.laravel.com
